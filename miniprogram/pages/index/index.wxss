page {
  background: #f6f7fb;
  color: #171923;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 20rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand-image {
  width: 108rpx;
  height: 108rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 36rpx rgba(38, 45, 71, 0.14);
}

.brand {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 60rpx;
}

.tagline {
  color: #697386;
  font-size: 26rpx;
  line-height: 38rpx;
}

.primary-button::after,
.account-button::after {
  border: none;
}

.panel,
.settings-card,
.result-card,
.account-card {
  background: #ffffff;
  border: 1rpx solid #ebedf4;
  border-radius: 16rpx;
  box-shadow: 0 18rpx 44rpx rgba(38, 45, 71, 0.06);
}

.section-title {
  color: #171923;
  font-size: 28rpx;
  font-weight: 700;
}

.tabs {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  background: #e9ecf5;
  border-radius: 18rpx;
}

.tab {
  height: 64rpx;
  border-radius: 14rpx;
  color: #697386;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 64rpx;
  text-align: center;
}

.tab-active {
  background: #ffffff;
  color: #171923;
  box-shadow: 0 8rpx 24rpx rgba(38, 45, 71, 0.08);
}

.panel {
  padding: 22rpx;
}

.upload-card {
  min-height: 360rpx;
  padding: 42rpx 28rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #6557ff 0%, #7a69f8 48%, #39c3b6 100%);
  color: #ffffff;
  text-align: center;
  box-sizing: border-box;
}

.upload-icon {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 60rpx;
  line-height: 88rpx;
}

.primary-button[disabled] {
  background: #9b94ff;
  color: rgba(255, 255, 255, 0.9);
}

.upload-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
  word-break: break-all;
}

.upload-meta {
  margin: 12rpx auto 28rpx;
  max-width: 560rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  line-height: 34rpx;
}

.upload-action {
  display: inline-block;
  min-width: 168rpx;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 30rpx;
  background: #ffffff;
  color: #6557ff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.input-section,
.summary-grid,
.settings-card,
.result-card {
  margin-top: 22rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.muted {
  color: #8a94a6;
  font-size: 22rpx;
}

.draft-input {
  width: 100%;
  height: 210rpx;
  padding: 22rpx;
  border: 1rpx solid #e4e7ef;
  border-radius: 14rpx;
  background: #fbfcff;
  box-sizing: border-box;
  color: #171923;
  font-size: 26rpx;
  line-height: 38rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.summary-item {
  padding: 20rpx;
  border-radius: 14rpx;
  background: #f7f8fc;
}

.summary-label {
  color: #8a94a6;
  font-size: 22rpx;
}

.summary-value {
  margin-top: 8rpx;
  color: #171923;
  font-size: 26rpx;
  font-weight: 700;
}

.primary-button {
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  border-radius: 16rpx;
  background: #6557ff;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.settings-card {
  padding: 22rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  border-bottom: 1rpx solid #eef0f5;
  color: #171923;
  font-size: 26rpx;
}

.picker-row text:last-child {
  color: #6557ff;
  font-weight: 600;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.chip-grid.compact {
  margin-top: 16rpx;
}

.chip {
  min-width: 128rpx;
  height: 64rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e3e6ef;
  border-radius: 12rpx;
  color: #4b5568;
  font-size: 24rpx;
  line-height: 64rpx;
  text-align: center;
  box-sizing: border-box;
}

.chip-active {
  border-color: #6557ff;
  background: #f0efff;
  color: #5646f0;
  font-weight: 700;
}

.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef0f5;
}

.toggle-row:last-child,
.picker-row:last-child {
  border-bottom: none;
}

.toggle-title {
  font-size: 26rpx;
  font-weight: 700;
}

.toggle-desc {
  margin-top: 6rpx;
  color: #8a94a6;
  font-size: 22rpx;
  line-height: 32rpx;
}

.result-card {
  padding: 22rpx;
}

.result-line {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f7f8fc;
}

.result-title {
  color: #171923;
  font-size: 25rpx;
  font-weight: 700;
}

.result-text {
  margin-top: 8rpx;
  color: #4b5568;
  font-size: 24rpx;
  line-height: 36rpx;
}

.account-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 22rpx;
}

.account-title {
  color: #171923;
  font-size: 26rpx;
  font-weight: 700;
}

.account-desc {
  margin-top: 6rpx;
  color: #8a94a6;
  font-size: 22rpx;
  line-height: 32rpx;
}

.account-button,
.account-badge {
  flex-shrink: 0;
  min-width: 140rpx;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 60rpx;
  text-align: center;
  box-sizing: border-box;
}

.account-button {
  background: #171923;
  color: #ffffff;
}

.account-badge {
  background: #eef9f6;
  color: #148c7d;
}
